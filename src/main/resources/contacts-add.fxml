<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane fx:id="backgroundPane" prefHeight="140.0" prefWidth="200.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.voidmirror.voicechat.frontend.ContactAddController">
   <children>
      <TextField alignment="CENTER" fx:id="tfContactName" layoutX="27.0" layoutY="29.0" promptText="Contact name" />
      <TextField alignment="CENTER" fx:id="tfContactIp" layoutX="27.0" layoutY="62.0" promptText="Contact ip" />
      <Button fx:id="btnAddContact" layoutX="44.0" layoutY="98.0" mnemonicParsing="false" onAction="#addContact" prefHeight="25.0" prefWidth="52.0" text="Add" />
      <Button fx:id="btnCancel" layoutX="107.0" layoutY="98.0" mnemonicParsing="false" onAction="#cancel" text="Cancel" />
   </children>
</AnchorPane>
